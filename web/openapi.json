  "info": {
    "title": "ExiledBroker",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/backtest": {
      "get": {
        "description": "Would following the site's tools have paid? The backtest's report (one item; empty\nuntil `eb backtest run` has been run on the research database and seeded).",
        "operationId": "backtest_report_api_backtest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BacktestReport"
                  },
                  "title": "Response Backtest Report Api Backtest Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Backtest Report",
        "tags": [
          "market"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/launch/picks": {
      "get": {
        "description": "What to buy in each early-league window, ranked from past leagues (empty until\n`eb launch picks` has been run on the research database and seeded).",
        "operationId": "picks_api_launch_picks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LaunchWindow"
                  },
                  "title": "Response Picks Api Launch Picks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Picks",
        "tags": [
          "market"
        ]
      }
    },
    "/api/missed/{league}": {
      "get": {
        "description": "What the latest 1, 2 and 3 published hours offered: key movers, volatile items\nand the loops and card turn-ins that left the most on the table. All three\nlook-backs at once (a few KB), computed once per loaded hour.",
        "operationId": "missed_opportunities_api_missed__league__get",
        "parameters": [
          {
            "in": "path",
            "name": "league",
            "required": true,
            "schema": {
              "title": "League",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MissedWindow"
                  },
                  "title": "Response Missed Opportunities Api Missed  League  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Missed Opportunities",
        "tags": [
          "live"
        ]
      }
    },
    "/api/status": {
      "get": {
        "description": "Leagues on the exchange, newest data first, the data version, and the announced\nnext league until it has trades. Cheap: poll this, and refetch everything else when\n`data_version` changes.",
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status",
        "tags": [
          "live"
        ]
      }
    }
  }
}
