# Copy to .env (gitignored) and adjust. Every setting is EB_<name> (src/exiledbroker/config.py).

# The site's database. Locally: the compose `db` service. Hosted: Railway Postgres's private
# URL (both the web service and the pipeline; the app doesn't use prepared statements).
# Unset, the site reads the local DuckDB file.
EB_DATABASE_URL=postgresql://eb:eb@localhost:55432/exiledbroker

# The next league as GGG announced it, for the landing page's countdown to its first
# published hour (UTC). Clear them once the league is running.
# EB_NEXT_LEAGUE=Allflame
# EB_NEXT_LEAGUE_START=2026-07-24T22:00:00Z
